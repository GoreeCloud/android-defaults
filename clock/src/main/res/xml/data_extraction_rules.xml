<?xml version="1.0" encoding="utf-8"?>
<!-- GoreeShield: keep all app-private Clock data on the originating device.
     Android 12+ treats cloud backup and device-to-device transfer separately. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
